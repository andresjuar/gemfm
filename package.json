{
  "name": "gemfm",
  "version": "2.0.0",
  "private": true,
  "description": "gem.fm MVP: discover emerging artists, go to their gigs, share with friends",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-local-db.ts",
    "import:artists": "tsx --env-file-if-exists=.env scripts/import-artists.ts",
    "radar": "tsx --env-file-if-exists=.env scripts/radar.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.13.20",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.11",
    "@netlify/functions": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
