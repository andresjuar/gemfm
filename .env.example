# Copy to .env for local use. Never commit .env.

# Supabase › Connect › Connection string › "Transaction pooler" (port 6543).
# Leave empty to use the local PGlite database in .pglite/ instead.
DATABASE_URL=

# Protects the Artists page (adding artists, gigs, approving radar finds).
# Leave empty locally; set it in Netlify.
ADMIN_KEY=

# Optional: comma-separated seed artists for the radar when the database has
# fewer than 3 artists linked to Deezer.
RADAR_SEEDS=Ed Maverick, Silvana Estrada, Girl Ultra, Little Jesus, Kevin Kaarl

# Optional: timezone used for "today" (daily challenge) and gig times.
APP_TIMEZONE=America/Mexico_City
